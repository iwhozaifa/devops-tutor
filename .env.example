# Local development defaults. In production these come from SSM Parameter
# Store (see docs/DEPLOYMENT.md). Validated at startup by src/lib/env.ts.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devtutor?schema=public"
# Production (RDS, TLS verified against the bundle baked into the image):
# DATABASE_URL="postgresql://app:<password>@<rds-endpoint>:5432/devtutor?sslmode=verify-full"
# MIGRATE_DATABASE_URL="postgresql://app:<password>@<rds-endpoint>:5432/devtutor?sslmode=require&sslcert=/app/certs/rds-global-bundle.pem&sslaccept=strict"

# openssl rand -base64 32
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
# Public origin of the app; required in production
AUTH_URL="http://localhost:3000"

# GitHub sign-in is enabled only when both are set
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Reverse proxies in front of the app that append to X-Forwarded-For (ALB = 1)
# TRUSTED_PROXY_HOPS=1
# Postgres connections per app process; keep instances x this under RDS max_connections
# DB_POOL_MAX=10
# debug | info | warn | error
# LOG_LEVEL=info

# Admins are granted via the database: npm run admin:promote -- <email>
